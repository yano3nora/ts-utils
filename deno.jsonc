{
  "tasks": {
    "dev": "deno test --watch",
    "test": "deno test",
    "build": "deno run -A build.ts",
    "link": "(cd npm && npm link)"
  },
  "test": {
    "exclude": ["npm/"]
  },
  "lint": {
    "exclude": ["npm/"]
  },
  "fmt": {
    "exclude": ["npm/", "README.md"],
    "singleQuote": true,
    "semiColons": false
  },
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.42.3",
    "@std/assert": "jsr:@std/assert@^1"
  }
}
